{
  // Cloudbite v0.0.1 — independent Worker. Never deploy gw-shinick's wrangler.jsonc for Cloudbite, and never point
  // this config at k.shinick.dev or lab.shinick.dev. Only cloudbite.shinick.dev is authorized as its custom hostname.
  //   npx wrangler dev -c wrangler.cloudbite.jsonc --env dev     (local; no external resources unless you set secrets)
  //   npx wrangler deploy -c wrangler.cloudbite.jsonc            (coordinator/operator decision, not done by workers)
  // Secrets (wrangler secret put … -c wrangler.cloudbite.jsonc): MASTER_KEY, SETUP_TOKEN (first admin key registration),
  //   CLOUDBITE_DAYTONA_API_KEY, CLOUDBITE_NOSANA_API_KEY; optional second-account CLOUDBITE_DAYTONA_SECONDARY_API_KEY.
  //   Optional third-account secret: CLOUDBITE_DAYTONA_TERTIARY_API_KEY (docs/daytona-tertiary-setup.md).
  //   Local onboarding: docs/daytona-secondary-setup.md. Missing settings are reported by name in /api/cloudbite/bootstrap.
  "name": "cloudbite-v001",
  "account_id": "96aee9d5fb56f2efc3d90e147a67f558",
  "assets": { "directory": "./deliverables" },
  "main": "src/index.ts",
  "build": { "command": "node tools/build-lab-renderer.mjs --check && node tools/build-lab-dom-capture.mjs --check && node tools/build-lab-demo-broadcast.mjs --check && node tools/build-cloudbite-console.mjs --check && node tools/build-cloudbite-access.mjs --check && node tools/build-cloudbite-computer.mjs --check" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.ps1"], "fallthrough": true }],
  "workers_dev": true,
  "routes": [{ "pattern": "cloudbite.shinick.dev", "custom_domain": true, "zone_id": "d2a16d55e1b69b18f6cba1105b32cc6c" }],
  "vars": {
    // Production workers.dev origin, verified against the authenticated account subdomain.
    // WebAuthn RP is this workers.dev host; admin keys are registered against this Worker's own State (not gw-shinick's).
    "RP_ID": "cloudbite-v001.ai-gongbu.workers.dev",
    "ORIGIN": "https://cloudbite-v001.ai-gongbu.workers.dev",
    "CLOUDBITE_PUBLIC_ORIGIN": "https://cloudbite.shinick.dev",
    "CLOUDBITE_CANONICAL_ONLY": "1",
    // Legacy lab hosts are disabled here: a non-routable placeholder origin and no seat domain.
    "LAB_ORIGIN": "https://lab.cloudbite.invalid",
    // Gateway the sandbox runner calls (/p/_cloudbite/worker/…). Same workers.dev host.
    "CLOUDBITE_GATEWAY_URL": "https://cloudbite-v001.ai-gongbu.workers.dev",
    // Official OpenAI-compatible Nosana gateway (https://learn.nosana.com/api/llm.html) and a model from its live
    // /v1/models catalogue, which changes over time (no key here — secret CLOUDBITE_NOSANA_API_KEY).
    "CLOUDBITE_NOSANA_BASE_URL": "https://inference.nosana.com/v1",
    "CLOUDBITE_NOSANA_MODEL": "qwen/qwen3.8-27b",
    // Daytona API for Cloudbite's own organization/key (secret CLOUDBITE_DAYTONA_API_KEY). Optional snapshot with python3.
    "CLOUDBITE_DAYTONA_API_URL": "https://app.daytona.io/api",
    "CLOUDBITE_DAYTONA_SNAPSHOT": "",
    "CLOUDBITE_COMPUTER_SNAPSHOT": "cloudbite-computer-d2e6a902c06d",
    "CLOUDBITE_COMPUTER_GATEWAY_ORIGIN": "https://cloudbite-desktop.ai-gongbu.workers.dev",
    "CLOUDBITE_COMPUTER_PROXY_SUFFIXES": ".daytonaproxy01.net,.proxy.daytona.works"
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "State" },
      { "name": "CLOUDBITE", "class_name": "CloudbiteProject" },
      { "name": "CLOUDBITE_ACCESS", "class_name": "CloudbiteAccess" },
      { "name": "CLOUDBITE_HISTORY", "class_name": "CloudbiteHistory" },
      { "name": "CLOUDBITE_COMPUTER", "class_name": "CloudbiteComputer" },
      { "name": "CLOUDBITE_COMPUTER_NESTED", "class_name": "CloudbiteComputerNested" },
      { "name": "CLOUDBITE_COMPUTER_ACCESS", "class_name": "CloudbiteComputerAccess" },
      { "name": "CLOUDBITE_COMPUTER_INPUT", "class_name": "CloudbiteComputerInput" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["State", "CloudbiteProject"] },
    // Audience access inbox (src/cloudbite-access-service.ts). v1 is never edited.
    { "tag": "v2", "new_sqlite_classes": ["CloudbiteAccess"] },
    { "tag": "v3", "new_sqlite_classes": ["CloudbiteHistory"] },
    { "tag": "v4", "new_sqlite_classes": ["CloudbiteComputer", "CloudbiteComputerNested"] },
    { "tag": "v5", "new_sqlite_classes": ["CloudbiteComputerAccess"] },
    { "tag": "v6", "new_sqlite_classes": ["CloudbiteComputerInput"] }
  ],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 1 } },
  "env": {
    "dev": {
      "vars": {
        "RP_ID": "localhost", "ORIGIN": "http://localhost:8808", "LAB_ORIGIN": "http://lab.cloudbite.invalid",
        "CLOUDBITE_GATEWAY_URL": "", "CLOUDBITE_ALLOW_HTTP": "1",
        "CLOUDBITE_NOSANA_BASE_URL": "", "CLOUDBITE_NOSANA_MODEL": "", "CLOUDBITE_DAYTONA_API_URL": "", "CLOUDBITE_DAYTONA_SNAPSHOT": "",
    "CLOUDBITE_COMPUTER_SNAPSHOT": "",
    "CLOUDBITE_COMPUTER_GATEWAY_ORIGIN": "",
    "CLOUDBITE_COMPUTER_PROXY_SUFFIXES": ".daytonaproxy01.net,.proxy.daytona.works"
      },
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "STATE", "class_name": "State" },
          { "name": "CLOUDBITE", "class_name": "CloudbiteProject" },
          { "name": "CLOUDBITE_ACCESS", "class_name": "CloudbiteAccess" },
          { "name": "CLOUDBITE_HISTORY", "class_name": "CloudbiteHistory" },
      { "name": "CLOUDBITE_COMPUTER", "class_name": "CloudbiteComputer" },
      { "name": "CLOUDBITE_COMPUTER_NESTED", "class_name": "CloudbiteComputerNested" },
      { "name": "CLOUDBITE_COMPUTER_ACCESS", "class_name": "CloudbiteComputerAccess" },
      { "name": "CLOUDBITE_COMPUTER_INPUT", "class_name": "CloudbiteComputerInput" }
        ]
      }
    }
  }
}
