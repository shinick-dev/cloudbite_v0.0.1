      "html": "<div class=\"ds-bar\"><span class=\"ds-sim\"><span class=\"ds-dot\"></span>Pitch simulation · scripted replay</span></div>",
      "css": ":host,:root{--navy:#0f1e3a;--navy-2:#1a2d52;--blue:#1f6feb;--blue-dark:#1758c4;--blue-50:#eef4ff;--blue-100:#dde9fc;--line:#d8e4f4;--canvas:#f3f7fd;--paper:#fff;--ink:#12223d;--text:#26364f;--muted:#5a6982;--stream:#0b1528;--stream-line:#1d2c47;--stream-text:#c9d6ea;--amber:#8a5a12;--amber-bg:#fbf1dc;--radius:13px;--focus:#1f6feb;font:14px/1.6 'Segoe UI',system-ui,-apple-system,Arial,sans-serif;color:var(--text)} .ds-bar{background:var(--navy);padding:16px}.ds-sim{font-size:12px;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;color:#ffd58a;border:1px solid #3a5079;border-radius:999px;padding:4px 10px}.ds-dot{width:6px;height:6px;background:currentColor;border-radius:50%;display:inline-block}"
