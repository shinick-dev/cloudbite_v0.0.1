  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Run / Run again — the single solid-blue action in the project card.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M8 5.5v13l10.5-6.5z'/></svg><span>Run again</span></button>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-primary{display:inline-flex;align-items:center;gap:7px;border-radius:var(--radius-sm);cursor:pointer;font:600 14px/1.5 var(--font);white-space:nowrap;background:var(--blue);color:var(--blue-ink);border:1px solid var(--blue);padding:8px 16px;transition:background-color .15s}.ds-primary:hover:not(:disabled){background:var(--blue-hover)}.ds-primary:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Tool Button",
      "kind": "button",
      "refersTo": "button-tool",
      "description": "Workspace tools: Full screen, Clear view, Restore history.",
      "html": "<button class=\"ds-tool\" type=\"button\" aria-pressed=\"false\"><svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5'/></svg><span>Full screen</span></button>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-tool{display:inline-flex;align-items:center;gap:7px;border-radius:var(--radius-sm);cursor:pointer;white-space:nowrap;background:var(--sunk);color:var(--ink);border:1px solid var(--line);padding:6px 10px;font:600 12.5px/1.5 var(--font);transition:border-color .15s,color .15s}.ds-tool:hover:not(:disabled){border-color:var(--blue);color:var(--blue)}.ds-tool:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-tool:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item-selected",
      "description": "224px light sidebar; the current view is a solid bright-blue item.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><span class=\"ds-nav-label\">Workspace</span><button class=\"ds-nav-btn\" aria-current=\"page\" type=\"button\"><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M3 11l9-7 9 7'/><path d='M5 10v10h14V10'/><path d='M10 20v-6h4v6'/></svg><span>Home</span></button><button class=\"ds-nav-btn\" aria-current=\"false\" type=\"button\"><svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2 2 2 0 0 0 2 2h14'/><path d='M8 7h8M8 11h6'/></svg><span>Guide</span></button></nav>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-nav{width:224px;background:#f8fbff;border-right:1px solid var(--line);padding:18px 14px;display:flex;flex-direction:column;gap:4px}.ds-nav-label{font-size:11px;font-weight:700;color:var(--faint);text-transform:uppercase;letter-spacing:.06em;padding:0 10px 6px}.ds-nav-btn{width:100%;display:flex;align-items:center;gap:10px;padding:10px 12px;border:0;border-radius:var(--radius-sm);background:transparent;color:var(--muted);font:550 14px/1.5 var(--font);cursor:pointer;text-align:left}.ds-nav-btn:hover{background:var(--blue-softer);color:var(--ink)}.ds-nav-btn[aria-current=\"page\"]{background:var(--blue);color:var(--blue-ink);font-weight:650}.ds-nav-btn:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
