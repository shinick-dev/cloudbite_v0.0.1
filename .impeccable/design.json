    {
      "name": "Expert Card",
      "kind": "card",
      "refersTo": "panel",
      "description": "Roster card above the stream: status dot, name, completion and a self-assessed direction chip.",
      "html": "<button class=\"ds-card is-focus\" type=\"button\"><span class=\"ds-card-head\"><span class=\"ds-dot\"></span><span class=\"ds-card-name\">Product Manager</span></span><span class=\"ds-card-foot\">Completed <span class=\"ds-chip\">Conditional 73%</span></span></button>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-card{min-width:150px;max-width:220px;display:flex;flex-direction:column;gap:3px;text-align:left;padding:8px 12px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--surface);cursor:pointer;font:inherit;color:inherit}.ds-card:hover{border-color:var(--line-strong)}.ds-card.is-focus{border-color:var(--blue);background:var(--blue-softer);box-shadow:inset 0 0 0 1px var(--blue)}.ds-card:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-card-head{display:flex;align-items:center;gap:6px}.ds-card-name{font-weight:650;font-size:13px}.ds-card-foot{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--muted)}.ds-dot{width:8px;height:8px;border-radius:50%;background:var(--support)}.ds-chip{font-size:11.5px;font-weight:650;padding:2px 8px;border-radius:999px;background:#fdf2dc;color:#6e4a00}"
    },
    {
      "name": "Execution Stream",
      "kind": "custom",
      "refersTo": "execution-stream",
      "description": "Read-only dark activity log (394px); no input or terminal prompt.",
      "html": "<div class=\"ds-stream\"><div class=\"ds-stream-bar\"><svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M3 12h4l3-7 4 14 3-7h4'/></svg><span class=\"ds-stream-title\">Execution stream</span><span class=\"ds-stream-ro\">read-only</span><span class=\"ds-stream-state\">simulated · completed · 0 active · 3 events</span></div><ol class=\"ds-log\" role=\"log\" aria-label=\"Execution stream\" tabindex=\"0\"><li class=\"ds-row k-tool\"><span class=\"at\">16:23:39</span><span class=\"who\">UX Architect</span><span class=\"kind\">tool</span><span class=\"msg\">write_file out/notes.md — first-use flow storyboard</span></li><li class=\"ds-row k-artifact\"><span class=\"at\">16:23:40</span><span class=\"who\">FP&amp;A Analyst</span><span class=\"kind\">file</span><span class=\"msg\">Submitted out/result.json — Support · confidence 73%</span></li></ol></div>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-stream{background:var(--stream);border-radius:12px;border:1px solid #06102a;color:var(--stream-ink);display:flex;flex-direction:column;height:394px;overflow:hidden}.ds-stream-bar{display:flex;align-items:center;gap:8px;padding:9px 14px;border-bottom:1px solid var(--stream-line);font-size:12.5px;flex-wrap:wrap}.ds-stream-bar svg{color:#6ea8ff}.ds-stream-title{font-weight:650;color:#fff}.ds-stream-ro{font-size:11px;padding:1px 7px;border-radius:999px;border:1px solid var(--stream-line);color:var(--stream-muted)}.ds-stream-state{margin-left:auto;color:var(--stream-muted);font:12px var(--mono)}.ds-log{list-style:none;margin:0;padding:8px 0;overflow:auto;flex:1;font:12.5px/1.6 var(--mono)}.ds-log:focus-visible{outline:2px solid var(--blue);outline-offset:-2px}.ds-row{display:grid;grid-template-columns:70px 150px 64px minmax(0,1fr);gap:10px;padding:1px 14px}.ds-row:hover{background:#0f1d3f}.ds-row .at,.ds-row .kind{color:var(--stream-muted)}.ds-row .who{color:#8fb8ff}.ds-row.k-tool .kind{color:#7fd1ff}.ds-row.k-artifact .kind{color:#7ee2b8}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Project setup field with label and character counter.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-title\">Project name</label><input id=\"ds-title\" class=\"ds-input\" type=\"text\" value=\"Launch a 100-expert AI advisory room\"><span class=\"ds-count\">36 / 120</span></div>",
      "css": ":host,:root{--canvas:#eef4fc;--surface:#ffffff;--sunk:#f5f8fd;--ink:#0f1f3d;--muted:#5b6b86;--faint:#64748b;--line:#d9e5f5;--line-strong:#bdd0ea;--navy:#0b1d3f;--navy-2:#13294f;--navy-ink:#e8efff;--blue:#1f6feb;--blue-hover:#185bc4;--blue-ink:#ffffff;--blue-soft:#e7f0fe;--blue-softer:#f2f7ff;--stream:#0a1530;--stream-line:#1c2c52;--stream-ink:#d5e1f7;--stream-muted:#7f93ba;--support:#147a50;--support-soft:#e3f6ee;--radius:14px;--radius-sm:10px;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;--mono:ui-monospace,'Cascadia Mono','SFMono-Regular',Consolas,monospace;font:14px/1.5 var(--font);color:var(--ink)} .ds-field{display:flex;flex-direction:column;gap:4px;max-width:360px}.ds-label{font-weight:600;font-size:13px}.ds-input{width:100%;box-sizing:border-box;border:1px solid var(--line-strong);border-radius:var(--radius-sm);padding:8px 10px;background:var(--surface);font:inherit;color:inherit}.ds-input:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-count{align-self:flex-end;font-size:11px;color:var(--faint)}"
    }
  ],
  "narrative": {
    "northStar": "Expert workspaces on a blue-white console",
    "overview": "The console is dense and operational: 13–14px body text, small uppercase eyebrows, mono only for the stream, file paths and timestamps. Colour carries state, not decoration. Honesty is part of the visual system: the run mode is always visible, confidence is labelled as self-assessment, and counts derive from verified run data.",
    "keyCharacteristics": [
      "Navy frame, blue-white work area, one bright blue accent for actions and selection.",
      "Flat panels separated by 1px pale-blue borders; no drop shadows on containers.",
      "A near-black navy stream as the single dark surface inside the workspace.",
      "Four opinion directions (support / conditional / concern / abstain) with fixed colours.",
      "System font stack only; no web fonts, no CDN, icons as inline SVG data-URI masks."
    ],
    "rules": [
      {
        "name": "The Mode-Is-Always-Visible Rule",
        "body": "Every screen shows the run mode twice: a header badge (amber \"Browser demo\" or green \"Live\") and a banner under the header stating what is and isn't real (\"Browser demo — simulated activity and files; no Daytona or Nosana calls.\").",
        "section": "colors"
      },
      {
        "name": "The Blue-Means-Selected Rule",
        "body": "A solid `blue` fill marks the current nav item (`aria-current=\"page\"`); tinted `blue-softer` with a `blue` border marks a selected expert card, catalogue option or file.",
        "section": "colors"
      },
      {
        "name": "The Border-Not-Shadow Rule",
        "body": "Panels separate by border and tone; never add ambient drop shadows to cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the pinned frame: 70px navy header, 224px light sidebar, central workspace, right progress/decision rail, 394px dark stream.",
      "**Do** label demo output as simulated in the header badge, the banner, the stream state and exported files.",
      "**Do** describe confidence as self-assessment and aggregate only completed, valid opinions; show failed/pending/cancelled counts beside it.",
      "**Do** use the system font stack and inline SVG mask icons; no external fonts or CDN assets (same-origin CSP)."
    ],
    "donts": [
      "**Don't** add a command input or terminal prompt to the execution stream; it is read-only.",
      "**Don't** reintroduce the earlier warm off-white / forest-green palette.",
      "**Don't** imply calibrated accuracy, live provider execution in demo mode, or capacity beyond what the console states.",
      "**Don't** add drop shadows to panels or a second accent colour for actions."
    ]
  }
}
