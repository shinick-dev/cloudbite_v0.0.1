# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# Comma-separated fallback models used when the primary fails (OpenRouter "models" routing)
# OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,google/gemini-flash-1.5
# OPENROUTER_APP_URL=https://your-company.example
# OPENROUTER_APP_TITLE=Classroom TA Agent

# Courses: a directory of *.json files (many courses) and/or a single file
TA_COURSES_DIR=courses
# TA_COURSE_FILE=courses/ai.example.json
TA_PERSONA_NAME=Hana

# Server auth (two different random values, 16+ chars each)
TA_INSTRUCTOR_TOKEN=
TA_STUDENT_TOKEN=
TA_RATE_LIMIT_PER_MIN=20            # per session (X-Session-Id) per minute
TA_RATE_LIMIT_PER_IP_PER_MIN=400    # per IP per minute (a classroom behind one NAT)
TA_AUTH_FAIL_LIMIT_PER_MIN=10       # failed token attempts per IP per minute
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
# TA_TRUST_PROXY=0

# Optional LLM guard classifier (second line of defense)
# TA_GUARD_MODEL=openai/gpt-4o-mini
# TA_GUARD_MODE=flagged        # flagged | all
# TA_GUARD_FAIL_CLOSED=0       # 1 = refuse when the guard is unavailable

# Tuning
# TA_TEMPERATURE=0.3
# TA_MAX_OUTPUT_TOKENS=800
# TA_MAX_INPUT_CHARS=2000
# TA_MAX_HISTORY_TURNS=10
# TA_REQUEST_TIMEOUT=30
# TA_MAX_RETRIES=1
# TA_LOG_LEVEL=INFO

# Cloudbite classroom bot (python -m ta_agent.cloudbite_cli)
# TA_CLOUDBITE_TOKEN=la_...          # assistant grant token; never put it in argv or URLs
# TA_CLOUDBITE_ORIGIN=https://k.shinick.dev
# TA_CLOUDBITE_COURSE_ID=genai-101
# TA_CLOUDBITE_STATE=~/.classroom-ta/cloudbite-bot-state.json   # default: outside the repo
